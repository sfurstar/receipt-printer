{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Original",
      "type": "shell",
      "command": "mkdir -p build && clang++ -std=c++17 -Wall -g src/OriginalReceiptPrinter.cpp -o build/receipt_printer",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Original",
      "type": "shell",
      "command": "./build/receipt_printer",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Build Original",
      "presentation": { "focus": true, "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Build Current File",
      "type": "shell",
      "command": "mkdir -p build && clang++ -std=c++17 -Wall -g \"${file}\" -o \"build/${fileBasenameNoExtension}\"",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}
